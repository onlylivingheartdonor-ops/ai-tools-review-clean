{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tools-review-clean",
  "compatibility_date": "2025-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
